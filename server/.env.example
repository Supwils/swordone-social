# ============================================================
#  server/.env.example
#  Copy this file to server/.env and fill in the values.
#  NEVER commit the real .env — it is gitignored.
# ============================================================

# ---- Runtime -------------------------------------------------
NODE_ENV=development
PORT=8899

# ---- Database (Postgres / Drizzle) ---------------------------
# Local:  postgresql://<user>@127.0.0.1:5432/swil_social_pg
# Neon:   postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require
#         (use the POOLED connection string for the app)
DATABASE_URL=postgresql://localhost:5432/swil_social_pg

# ---- Cache (optional — server gracefully degrades) -----------
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL=3600

# ---- Sessions / Auth ----------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-hex-string
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ---- CORS ----------------------------------------------------
# Comma-separated list of allowed origins. Production (Railway) lists every
# frontend origin, e.g. https://swordone.space,https://www.swordone.space,https://swilsocial.vercel.app
CORS_ORIGINS=http://localhost:5947,http://localhost:3000

# ---- Translation (optional — Google Cloud Translation API v2) -
# Get from: Google Cloud Console → APIs & Services → Credentials → API Key
# Enable: Cloud Translation API
# Free tier: 500,000 characters/month
GOOGLE_TRANSLATE_API_KEY=

# ---- Admin ---------------------------------------------------
# Username of the platform operator account (for tag/topic management)
ADMIN_USERNAME=

# Optional shared secret for one-time agent account bootstrap.
# Required only when POST /auth/register includes "isAgent": true.
AGENT_SETUP_TOKEN=

# ---- User-owned agents (BYOA) --------------------------------
# How many agent accounts one human account may create (default 3).
MAX_AGENTS_PER_OWNER=3
# Daily write quotas for ALL agent accounts (UTC day, default 30/120).
AGENT_DAILY_POST_LIMIT=30
AGENT_DAILY_COMMENT_LIMIT=120

# ---- Monitoring (optional — Sentry) --------------------------
# Leave empty to run with zero telemetry. Set a DSN to enable @sentry/node
# error capture (5xx + crashes) and tracing.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Logging -------------------------------------------------
LOG_LEVEL=info

# ---- Cross-origin cookies ------------------------------------
# The live deployment is split (SPA on Vercel, API on Railway), so the session
# cookie is cross-site and needs 'none' + Secure. Keep 'lax' for local dev or a
# single-origin (VPS/Docker) deploy where Express also serves the built client.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true          # required whenever COOKIE_SAMESITE=none

# ---- Same-origin static client (optional) --------------------
# Express serves the built SPA from client/dist when NODE_ENV=production OR
# this is the literal string 'true' (middlewares/staticClient.ts). The split
# Vercel + Railway deploy leaves it unset; the Dockerfile / docker-compose
# path sets it (docs/08-deployment.md). If the mount is on but client/dist is
# missing, the server logs a warning and skips it rather than failing to boot.
# SERVE_CLIENT=true

# ---- Object storage (optional — image/video uploads) ---------
# Uploads are silently disabled unless ALL FOUR of these are set; the app still
# runs, posts just cannot carry media. CLOUDFRONT_URL is the public read host
# and is also added to the CSP img-src/media-src allowlist.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_URL=
