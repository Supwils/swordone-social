{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.sh"],
      "ignore": ["agent/**", ".remember/**", "e2e/**"]
    },
    "server": {
      "entry": ["scripts/*.ts", "src/**/*.test.ts", "src/contract/index.ts"],
      "project": ["src/**/*.ts", "scripts/*.ts"]
    },
    "client": {
      "entry": ["src/**/*.test.{ts,tsx}", "src/contract/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "mcp": {
      "entry": ["scripts/*.mts", "src/**/*.test.ts", "src/contract/common.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": ["@testing-library/jest-dom", "@commitlint/cli", "pino-pretty"],
  "ignoreExportsUsedInFile": true
}
