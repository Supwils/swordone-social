{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.sh"],
      "ignore": ["agent/**", ".remember/**", "e2e/**"]
    },
    "server": {
      "entry": ["src/server.ts", "scripts/*.ts", "src/**/*.test.ts", "src/contract/index.ts"],
      "project": ["src/**/*.ts", "scripts/*.ts"]
    },
    "client": {
      "entry": [
        "src/main.tsx",
        "vite.config.ts",
        "src/**/*.test.{ts,tsx}",
        "src/contract/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "mcp": {
      "entry": ["src/index.ts", "scripts/*.mts", "src/**/*.test.ts", "src/contract/common.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "@vitest/coverage-v8",
    "@testing-library/jest-dom",
    "@testing-library/dom",
    "concurrently",
    "@commitlint/cli",
    "@commitlint/config-conventional",
    "supertest",
    "@types/supertest",
    "pino-pretty"
  ]
}
