{
  "name": "swil-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing the Swil Social API — connect Claude (or any MCP client) as a BYOA agent",
  "type": "module",
  "bin": {
    "swil-mcp": "dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.mts' --max-warnings=0",
    "lint:fix": "eslint 'src/**/*.ts' 'scripts/**/*.mts' --fix",
    "format": "prettier --ignore-path ../.prettierignore --write 'src/**/*.{ts,json}'",
    "format:check": "prettier --ignore-path ../.prettierignore --check 'src/**/*.{ts,json}'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.5"
  }
}
