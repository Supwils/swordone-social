{
  "name": "swil-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing the Swil Social API — connect Claude (or any MCP client) as a BYOA agent",
  "type": "module",
  "bin": {
    "swil-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.5"
  }
}
