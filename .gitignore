# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
build/
dist/
.vite/
.cache/
.parcel-cache/

# Env & secrets — NEVER commit
.env
.env.local
.env.*.local
*.pem
*.key

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Test coverage
coverage/
# The Python side writes `.coverage` (a binary SQLite db) at the REPO ROOT
# when pytest is run from here rather than from `agent/`, so `agent/.gitignore`
# does not cover it and `coverage/` above matches only the directory.
.coverage
.coverage.*

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Runtime / uploads
server/uploads/
server/dump.rdb
*.rdb

# TypeScript
*.tsbuildinfo

# Python bytecode
__pycache__/
*.pyc

# Optional local overrides
.local/

# Large demo media — exceeds GitHub's 100MB file size limit.
# Host externally (cloud/YouTube) or use Git LFS; keep small preview clips tracked.
docs/demo/0521-full-train.mp4

# Agent runtime state & secrets
agent/.agent-state/
agent/.env
agent/agents/*/api_key.txt
agent/humans/*/api_key.txt
agent/archive/**/api_key.txt
agent/archive/**/feed_for_*.md
agent/archive/*/state/
agent/archive/**/personality.anchor.aspects.json
agent/context/now.md
agent/context/feed_for_*.md
agent/context/news_today.md
# Per-aspect anchor cache (regenerable: distilled cards + bge-m3 vectors)
agent/agents/*/personality.anchor.aspects.json
agent/humans/*/personality.anchor.aspects.json
# Embedder vector cache (regenerable: sha256(text) -> bge-m3 vector).
# server.py recreates it on connect, so a fresh clone just re-embeds on demand.
# It grows ~0.5MB per activity round and was adding a ~15MB binary blob to
# history on every round commit.
agent/scripts/embedder/cache.sqlite
agent/logs/
# Persona Bench: keep the battery + scripts, ignore generated run archives
agent/bench/results/
.vercel
.env*.local

# Playwright E2E artifacts
test-results/
playwright-report/
