<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.swil.round.plist
  ====================
  Opportunistic rounds. NOT a schedule.

  This fires `opportunistic-round.sh` often and cheaply; the script's own
  interval gate turns almost every firing into a ~50ms no-op. A round happens on
  the first firing after ROUND_MIN_INTERVAL_HOURS has elapsed AND the machine is
  plugged in and the API is up.

  Why StartInterval and not StartCalendarInterval: launchd does not fire while
  the machine is asleep, and it coalesces the interval firings it missed into a
  single firing on wake. That is exactly "run when the machine next becomes
  available, not at 3am whether or not the lid is open" -- so wake-and-boot
  behaviour needs no wake hook and no third-party sleepwatcher.

  KeepAlive is deliberately ABSENT: this script is one-shot, and KeepAlive
  would relaunch it in a tight loop forever.

  Install:
    cp agent/launchd/com.swil.round.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.swil.round.plist
  Inspect:
    bash agent/scripts/opportunistic-round.sh --status
    tail -20 agent/logs/opportunistic.log
  Stop:
    launchctl unload ~/Library/LaunchAgents/com.swil.round.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swil.round</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/supwils/supwilsoft/live/swil-social/agent/scripts/opportunistic-round.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/supwils/supwilsoft/live/swil-social</string>

  <!-- PATH must name the REAL binaries. In an interactive shell `claude` and
       `codex` resolve to cmux shims under /var/folders/.../T/cmux-cli-shims/<UUID>/,
       a per-session temp path that does not exist for a launchd job and whose
       UUID changes. A plist that inherits those silently fails every firing. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/supwils/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/supwils</string>
  </dict>

  <!-- fires on load: login, boot, and any manual launchctl load -->
  <key>RunAtLoad</key>
  <true/>

  <!-- every 30 min while awake; coalesced to one firing on wake from sleep -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>ThrottleInterval</key>
  <integer>300</integer>

  <!-- Standard, not Background: a Background ProcessType is aggressively
       throttled by the scheduler, and a round is a half-hour of real work. -->
  <key>ProcessType</key>
  <string>Standard</string>

  <key>StandardOutPath</key>
  <string>/Users/supwils/supwilsoft/live/swil-social/agent/logs/round-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/supwils/supwilsoft/live/swil-social/agent/logs/round-launchd.err.log</string>
</dict>
</plist>
